config_version: 2
interval: {{interval}}
fields_under_root: true
fields:
  _conf:
    interval: "{{interval}}"
    expiration: "{{expiration}}"
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
resource.url: {{url}}
redact:
  fields: ~
program: |-
  state.with(
    get_request(state.url).with({
      "Header": (state.?cursor.last_modified.orValue("") != "") ?
        {
          "User-Agent": ["Elastic-Agent tor integration/0.1.6"],
          "If-Modified-Since": [state.cursor.last_modified],
        }
      :
        {"User-Agent": ["Elastic-Agent tor integration/0.1.6"]},
    }).do_request().as(resp,
      (resp.StatusCode == 304) ?
        // The list has not changed since the last successful request.
        dyn({
          "events": [],
          "want_more": false,
        })
      : (resp.StatusCode == 200) ?
        dyn({
          "events": string(resp.Body).split("\n").map(l,
            l.trim_space() != "" && !l.has_prefix("#"),
            {
              "message": l.trim_space(),
            }
          ),
          "cursor": {"last_modified": resp.Header[?"Last-Modified"][?0].orValue("")},
          "want_more": false,
        })
      :
        dyn({
          "events": {
            "error": {
              "code": string(resp.StatusCode),
              "id": string(resp.Status),
              "message": "GET " + state.url + ": " + (
                (size(resp.Body) != 0) ?
                  string(resp.Body)
                :
                  string(resp.Status) + " (" + string(resp.StatusCode) + ")"
              ),
            },
          },
          "want_more": false,
        })
    )
  )
tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}
